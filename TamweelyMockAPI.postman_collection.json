      "name": "Inquiry (GetSuperPayDataByIDNO)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('status.code is 200 successful', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.status.code).to.eql(200);",
              "  pm.expect(json.status.message).to.eql('successful');",
              "});",
              "pm.test('returns the client data', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.CLIENTNAME).to.eql('نادر احمد محمد احمد');",
              "  pm.expect(json.NATIONALID).to.eql('30002316458974');",
              "  pm.expect(json.TOTALOUTSTANDING).to.eql(2960);",
              "  pm.expect(json.PAIDAMOUNT).to.eql(0);",
              "  pm.expect(json.NUMBEROFREMAININGINSTALLMENTS).to.eql(3);",
              "  pm.expect(json.NEXTMONTHLYDUEINSTALLMENT).to.eql(555);",
              "  pm.expect(json.PRIMIUMNO).to.eql(2);",
              "});"
            ]
          }
        }
      ],
